  "created_at" timestamp
  "updated_at" timestamp
}

Table "items" {
  "id" bigint [not null, increment]
  "product_id" char(4) [not null]
  "sku" varchar(50) [not null]
  "name" varchar(50) [not null]
  "measurement" varchar(6) [not null]
  "base_price" int [not null, default: '0']
  "selling_price" int [not null, default: '0']
  "purchase_unit" int [not null, default: '30']
  "sell_unit" int [not null, default: '30']
  "stock_unit" int [not null, default: '0']
  "minimum_stock" int [not null, default: '0']
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (id, sku) [pk]
  }
}

Table "log_base_price_supplier_product" {
  "id" bigint [pk, not null, increment]
  "supplier_id" char(6) [not null]
  "product_id" char(50) [not null]
  "old_base_price" int [not null]
  "new_base_price" int [not null]
  "created_at" timestamp
  "updated_at" timestamp
}

Table "log_material_inventory" {
  "id" bigint [pk, not null, increment]
  "log_id" varchar(50) [not null]
  "sku" varchar(50) [not null]
  "old_stock" int [not null, default: '0']
  "new_stock" int [not null, default: '0']
  "created_at" timestamp
  "updated_at" timestamp
  Note: 'Tabel ini menyimpan riwayat perubahan stok bahan baku (RM) untuk keperluan audit dan pelacakan perubahan stok bahan baku (RM). Tabel ini akan diupdate secara otomatis oleh sistem ketika ada transaksi Goods Receipt Note (GRN) yang terkait dengan Purchase Order (PO) untuk bahan baku dan Juga ketika ada transaksi produksi yang mengurangi stok bahan baku. Tabel ini bergantung dengan tabel material_inventory yang menyimpan stok bahan baku (RM) saat ini.'
}

Table "measurement_unit" {
  "id" bigint [pk, not null, increment]
  "unit_name" varchar(15) [not null]
