  "description" varchar(100) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    production_number [unique, name: "assortment_production_production_number_unique"]
  }
}

Table "assortment_production_detail" {
  "id" bigint [pk, not null, increment]
  "production_number" char(9) [not null]
