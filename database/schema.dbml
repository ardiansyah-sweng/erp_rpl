  "is_base_unit" tinyint(1) [not null]
  "created_at" timestamp
  "updated_at" timestamp
}

Table "goods_receipt_note" {
  "id" bigint [pk, not null, increment]
  "po_number" char(6) [not null]
  "product_id" varchar(50)
  "delivery_date" date [not null]
  "delivered_quantity" int [not null]
  "comments" varchar(255)
  "created_at" timestamp
  "updated_at" timestamp
}

Table "goods_returns" {
  "id" bigint [pk, not null, increment]
  "grn_id" bigint [not null, note: 'ID dari goods receipt note yang terkait']
  "po_number" char(6) [not null]
  "product_id" varchar(50) [not null]
  "return_date" date [not null]
  "return_quantity" int [not null]
  "reason" varchar(255) [not null]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (po_number, product_id) [name: "goods_returns_po_number_product_id_index"]
    grn_id [name: "goods_returns_grn_id_foreign"]
  }

  Note: 'Tabel ini menyimpan data retur barang'
}

Table "item_unit" {
  "id" bigint [pk, not null, increment]
  "sku" varchar(50) [not null]
  "unit_id" varchar(15) [not null]
